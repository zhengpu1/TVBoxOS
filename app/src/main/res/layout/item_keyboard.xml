<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboa"
    android:layout_width="fill_parent"
    android:layout_height="@dimen/vs_50"
    android:layout_gravity="center"
    android:layout_margin="@dimen/vs_4"
    android:background="@drawable/shape_user_home"
    android:focusable="true">

    <TextView
        android:id="@+id/keyName"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:shadowColor="@color/color_FF000000"
        android:shadowDx="1.3"
        android:shadowDy="1.3"
        android:shadowRadius="1.0"
        android:textColor="@color/font_deta_color"
        android:textSize="@dimen/ts_22" />
</FrameLayout>