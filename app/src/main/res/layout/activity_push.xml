<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/vs_480"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_300"
            android:layout_height="@dimen/vs_300"
            android:focusable="false"/>

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center"
            android:focusable="false"
            android:lineSpacingMultiplier="1.5"
            android:textAlignment="gravity"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_24"
            tools:text="11"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center"
            android:layout_margin="@dimen/vs_15"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pushLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_10"
                android:background="@drawable/shape_user_focus"
                android:focusable="true"
                android:padding="@dimen/vs_10"
                android:text="推送剪贴板内容"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_24"/>

            <EditText
                android:id="@+id/et_push_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="推送链接，影片名称，阿里token(格式为：token@xxxx)"
                android:inputType="text"
                android:background="@drawable/input_search"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_2"
                android:paddingTop="@dimen/vs_10"
                android:paddingRight="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_10"
                android:textColor="@color/color_FFFFFF"
                android:textColorHint="@color/color_66FFFFFF"
                android:textSize="@dimen/ts_24"/>

            <TextView
                android:id="@+id/confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="@dimen/vs_20"
                android:paddingVertical="@dimen/vs_10"
                android:background="@drawable/shape_user_focus"
                android:focusable="true"
                android:gravity="center"
                android:text="确定"
                android:layout_marginLeft="@dimen/vs_10"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_24"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>