<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_live_channel_num"
    android:paddingLeft="@dimen/vs_30"
    android:paddingTop="@dimen/vs_70"
    android:paddingRight="@dimen/vs_30"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/play_scale"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="16:9"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/audio_track_select"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="音轨"
        app:layout_constraintBottom_toBottomOf="@+id/play_scale"
        app:layout_constraintLeft_toRightOf="@+id/play_scale"
        app:layout_constraintTop_toTopOf="@+id/play_scale"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/landscape_portrait"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="横竖屏"
        app:layout_constraintBottom_toBottomOf="@+id/play_scale"
        app:layout_constraintLeft_toRightOf="@+id/audio_track_select"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/tvPtst"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="自动片头片尾开"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_scale"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/time_show"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="屏显"
        app:layout_constraintLeft_toRightOf="@+id/tvPtst"
        app:layout_constraintTop_toTopOf="@+id/tvPtst"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/tiny_progress"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="迷你进度"
        app:layout_constraintLeft_toRightOf="@+id/time_show"
        app:layout_constraintTop_toTopOf="@+id/time_show"/>
    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:id="@+id/tvIjkCachePlay"
        android:background="@drawable/button_dialog_main"
        android:padding="@dimen/vs_10"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_5"
        android:text="IJK缓存"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPtst"/>
</androidx.constraintlayout.widget.ConstraintLayout>