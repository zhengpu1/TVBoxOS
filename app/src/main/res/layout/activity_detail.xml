<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tvllLkkkk"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/box_controller_top_bg">

    <ImageView
        android:id="@+id/ivThumbs"
        android:layout_width="1280mm"
        android:layout_height="@dimen/vs_720"
        android:layout_marginTop="@dimen/vs_0"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/ivThumbsK"
        android:layout_width="1280mm"
        android:layout_height="@dimen/vs_720"
        android:layout_marginTop="@dimen/vs_0"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_10">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="@dimen/vs_250"
                android:layout_height="@dimen/vs_320"
                android:layout_marginTop="@dimen/vs_10"
                android:scaleType="fitXY" />

            <View
                android:id="@+id/previewPlayerPlace"
                android:layout_width="@dimen/vs_580"
                android:layout_height="@dimen/vs_320"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_320"
                android:layout_marginLeft="@dimen/vs_20"
                android:layout_marginTop="@dimen/vs_10"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_5"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="@color/color_FF000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:singleLine="true"
                        android:textColor="@color/color_FFF5E8DC"
                        android:textSize="@dimen/ts_30"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/vs_20"
                            android:layout_height="@dimen/vs_20"
                            android:layout_marginTop="@dimen/vs_12"
                            android:focusable="false"
                            android:scaleType="fitXY"
                            android:src="@drawable/dou32" />

                        <TextView
                            android:id="@+id/tvDouban"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/vs_10"
                            android:layout_marginRight="@dimen/vs_10"
                            android:ellipsize="end"
                            android:gravity="right"
                            android:maxLines="1"
                            android:paddingTop="@dimen/vs_8"
                            android:singleLine="true"
                            android:textColor="@color/color_themex"
                            android:textSize="@dimen/ts_20"
                            android:textStyle="italic" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llaSite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_5"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/vs_0"
                    android:paddingTop="@dimen/vs_1"
                    android:paddingRight="@dimen/vs_10"
                    android:paddingBottom="@dimen/vs_1">

                    <TextView
                        android:id="@+id/tvSite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_detail_play"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_5"
                        android:paddingTop="@dimen/vs_2"
                        android:paddingRight="@dimen/vs_5"
                        android:paddingBottom="@dimen/vs_2"
                        android:singleLine="true"
                        android:textColor="@color/font_deta_color"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_10"
                        android:singleLine="true"
                        android:textColor="@color/color_themex"
                        android:textSize="@dimen/ts_20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/data_bgv"
                        android:paddingLeft="@dimen/vs_5"
                        android:paddingTop="@dimen/vs_1"
                        android:paddingRight="@dimen/vs_5"
                        android:paddingBottom="@dimen/vs_1"
                        android:singleLine="true"
                        android:text="免费VIP"
                        android:textColor="@color/color_theme_s"
                        android:textSize="@dimen/ts_16" />

                    <TextView
                        android:id="@+id/tvNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/data_note"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_5"
                        android:paddingTop="@dimen/vs_1"
                        android:paddingRight="@dimen/vs_5"
                        android:paddingBottom="@dimen/vs_1"
                        android:singleLine="true"
                        android:textColor="@color/color_FFF5E8DC"
                        android:textSize="@dimen/ts_16" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_0"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_theme_h"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_0"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_theme_h"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_0"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_theme_h"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/vs_0"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/color_theme_h"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvWad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_10"
                    android:background="@drawable/button_deta_bac"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_10"
                    android:paddingBottom="@dimen/vs_5">

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/vs_5"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/color_03DAC5"
                        android:textSize="@dimen/ts_18" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDirector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/vs_20"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/color_03DAC5"
                            android:textSize="@dimen/ts_18" />

                        <TextView
                            android:id="@+id/tvWriter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/color_03DAC5"
                            android:textSize="@dimen/ts_18" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_deta_bac"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="1"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_10"
                    android:paddingBottom="@dimen/vs_1"
                    android:singleLine="true"
                    android:textColor="@color/color_03DAC5"
                    android:textSize="@dimen/ts_18" />

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="0mm"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/tvPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_120"
                        android:layout_gravity="center"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/button_detail_play1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/vs_36"
                        android:paddingTop="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_36">

                        <ImageView
                            android:id="@+id/tvPlaysk"
                            android:layout_width="@dimen/vs_40"
                            android:layout_height="@dimen/vs_40"
                            android:layout_gravity="center"
                            android:alpha="0.75"
                            android:duplicateParentState="true"
                            android:src="@drawable/expand"
                            app:tint="@color/font_deta_color1" />

                        <TextView
                            android:id="@+id/tvPlays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/vs_5"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:shadowColor="@color/color_FF000000"
                            android:shadowDx="1.3"
                            android:shadowDy="1.3"
                            android:shadowRadius="1"
                            android:singleLine="true"

                            android:textColor="@color/font_deta_color"
                            android:textSize="@dimen/ts_20" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvPush"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_120"
                        android:layout_gravity="center"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/button_detail_play1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/vs_36"
                        android:paddingTop="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_36">

                        <ImageView
                            android:id="@+id/tvPushl"
                            android:layout_width="@dimen/vs_40"
                            android:layout_height="@dimen/vs_40"
                            android:layout_gravity="center"
                            android:alpha="0.75"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_navigation"
                            app:tint="@color/font_deta_color1" />

                        <TextView
                            android:id="@+id/tvPushs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/vs_5"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:shadowColor="@color/color_FF000000"
                            android:shadowDx="1.3"
                            android:shadowDy="1.3"
                            android:shadowRadius="1"
                            android:singleLine="true"
                            android:text="剧情简介"
                            android:textColor="@color/font_deta_color"
                            android:textSize="@dimen/ts_20" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_120"
                        android:layout_gravity="center"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/button_detail_play1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/vs_36"
                        android:paddingTop="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_36">

                        <ImageView
                            android:id="@+id/tvSort1"
                            android:layout_width="@dimen/vs_40"
                            android:layout_height="@dimen/vs_40"
                            android:layout_gravity="center"
                            android:alpha="0.75"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_sort_down"
                            app:tint="@color/font_deta_color1" />

                        <TextView
                            android:id="@+id/tvSort2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/vs_5"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:shadowColor="@color/color_FF000000"
                            android:shadowDx="1.3"
                            android:shadowDy="1.3"
                            android:shadowRadius="1"
                            android:singleLine="true"
                            android:text="倒序显示"
                            android:textColor="@color/font_deta_color"
                            android:textSize="@dimen/ts_20" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvCollect"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_120"
                        android:layout_gravity="center"
                        android:background="@drawable/button_detail_play1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/vs_36"
                        android:paddingTop="@dimen/vs_20"
                        android:paddingRight="@dimen/vs_36">

                        <ImageView
                            android:id="@+id/tvCollect1"
                            android:layout_width="@dimen/vs_40"
                            android:layout_height="@dimen/vs_40"
                            android:layout_gravity="center"
                            android:alpha="0.75"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_shouca"
                            app:tint="@color/font_deta_color1" />

                        <TextView
                            android:id="@+id/tvCollect2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/vs_5"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:shadowColor="@color/color_FF000000"
                            android:shadowDx="1.3"
                            android:shadowDy="1.3"
                            android:shadowRadius="1"
                            android:singleLine="true"
                            android:text="加入收藏"
                            android:textColor="@color/font_deta_color"
                            android:textSize="@dimen/ts_20" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mEmptyPlaylist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/vs_128"
                android:layout_height="@dimen/vs_128"
                android:layout_gravity="center"
                android:src="@drawable/icon_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:gravity="center"
                android:text="暂无播放数据"
                android:textColor="@color/color_03DAC5"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.owen.tvrecyclerview.widget.TvRecyclerView
                        android:id="@+id/mGridViewFlag"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_45"
                        android:layout_marginLeft="@dimen/vs_30"
                        android:layout_marginTop="@dimen/vs_0"
                        android:layout_marginRight="@dimen/vs_30"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nextFocusDown="@+id/mSeriesGroupTv"
                        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                        app:tv_selectedItemIsCentered="true" />

                    <TextView
                        android:id="@+id/tvWeekday"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_40"
                        android:layout_marginTop="@dimen/vs_3"
                        android:layout_marginRight="@dimen/vs_40"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:paddingTop="@dimen/vs_10"
                        android:shadowColor="@color/color_FF000000"
                        android:shadowDx="0.5"
                        android:shadowDy="0.5"
                        android:shadowRadius="1"
                        android:singleLine="true"
                        android:text="全部影片免费观看，如播放失败，尝试切换解析或选择《更多站点》站点播放。"
                        android:textColor="@color/color_03DAC5"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mSeriesGroupTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_30"
                    android:layout_marginTop="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_10"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 排序功能按钮 -->
                    <TextView
                        android:id="@+id/mSeriesSortTv"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_45"
                        android:layout_marginRight="@dimen/vs_10"
                        android:background="@drawable/button_detail_sort"

                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusRight="@id/mNumberClassification"
                        android:nextFocusUp="@id/mGridViewFlag"
                        android:nextFocusDown="@id/mGridView"
                        android:paddingLeft="@dimen/vs_10"
                        android:paddingTop="@dimen/vs_5"
                        android:paddingRight="@dimen/vs_10"
                        android:paddingBottom="@dimen/vs_5"
                        android:shadowColor="@color/color_FF000000"
                        android:shadowDx="1.3"
                        android:shadowDy="1.3"
                        android:shadowRadius="1"
                        android:singleLine="true"
                        android:text="倒序"
                        android:textColor="@color/font_deta_color"
                        android:textSize="@dimen/ts_22" />

                    <com.owen.tvrecyclerview.widget.TvRecyclerView
                        android:id="@+id/mNumberClassification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/vs_0"
                        android:layout_marginTop="@dimen/vs_0"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nextFocusUp="@+id/mGridViewFlag"
                        android:nextFocusDown="@+id/mGridViewk"
                        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                        app:tv_selectedItemIsCentered="true"
                        app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
                </LinearLayout>

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mGridViewk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_30"
                    android:layout_marginTop="@dimen/vs_10"
                    android:layout_marginRight="@dimen/vs_30"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nextFocusUp="@+id/mNumberClassification"
                    app:tv_selectedItemIsCentered="true" />

                <TextView
                    android:id="@+id/tvWntj"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:ellipsize="end"
                    android:focusableInTouchMode="false"
                    android:paddingLeft="@dimen/vs_35"
                    android:paddingRight="@dimen/vs_30"
                    android:singleLine="true"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_22"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/tvHotList3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_80"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_30"
                    android:paddingBottom="@dimen/vs_5"
                    android:visibility="gone"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

                <TextView
                    android:id="@+id/tvWntjs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_5"
                    android:ellipsize="end"
                    android:focusableInTouchMode="false"
                    android:paddingLeft="@dimen/vs_35"
                    android:paddingRight="@dimen/vs_30"
                    android:singleLine="true"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_22" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/tvHotList5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/vs_25"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_30"
                    android:paddingBottom="@dimen/vs_20"
                    android:visibility="gone"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="@dimen/vs_580"
        android:layout_height="@dimen/vs_320"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_marginTop="@dimen/vs_20"
        android:layout_marginBottom="@dimen/vs_10"
        android:background="@drawable/notification_bg"
        android:visibility="gone" />

    <View
        android:id="@+id/previewPlayerBlock"
        android:layout_width="@dimen/vs_580"
        android:layout_height="@dimen/vs_320"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_marginTop="@dimen/vs_20"
        android:layout_marginBottom="@dimen/vs_10"
        android:background="@drawable/preview_player_block"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>