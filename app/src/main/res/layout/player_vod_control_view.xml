            android:layout_gravity="center_horizontal"
            android:id="@id/volume_progressbar"
            android:tag="progressbar_brightness"
            android:layout_width="5dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:max="100"
