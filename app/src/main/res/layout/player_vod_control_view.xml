    <TextView
        android:textSize="@dimen/ts_24"
        android:textColor="@color/color_80FFFFFF"
        android:layout_gravity="center"
        android:id="@+id/tv_play_load_net_speed"
        android:tag="play_load_net_speed"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_40"
        android:text="0"
        android:shadowColor="@color/color_000000_80"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="1"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-20mm"
        android:layout_marginRight="-20mm"
        android:layout_marginBottom="@dimen/vs_0">
        <SeekBar
            android:layout_gravity="center"
            android:id="@+id/seekBars"
            android:background="@null"
            android:padding="@dimen/vs_0"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/vs_2"
            android:max="1000"
            android:progressDrawable="@drawable/shape_player_control_vod_seek_thumba"
            android:minHeight="@dimen/vs_2"
            android:thumb="@null"
            android:thumbOffset="@dimen/vs_0"
            android:layout_weight="1"/>
