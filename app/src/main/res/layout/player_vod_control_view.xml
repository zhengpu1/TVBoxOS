            android:id="@+id/tvBackBimg"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:src="@drawable/ic_lock_alt_open"/>
    </LinearLayout>
    <com.github.tvbox.osc.subtitle.widget.SimpleSubtitleView
