<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/tvUserHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_1"
            android:layout_marginBottom="@dimen/vs_1"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_30"
            android:paddingRight="@dimen/vs_10">

            <LinearLayout
                android:id="@+id/tvHistory"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_5"
                android:layout_marginTop="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_16"
                android:layout_marginBottom="@dimen/vs_5"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:nextFocusLeft="@+id/tvSetting"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/icon_history"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="1.3"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.0"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="历史"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvLive"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/hm_live"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="1.3"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.0"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="直播"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/icon_search"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="1.3"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.0"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="搜索"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/tvPush"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_40"
                    android:layout_height="@dimen/vs_40"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/ic_send"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="1.3"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.0"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="推送"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvFavorite"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_60"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/icon_collect"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="收藏"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/tvSetting"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_16"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/icon_setting"
                    android:duplicateParentState="true"
                    app:tint="@color/font_deta_color1"/>

                <TextView
                    android:id="@id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="1.3"
                    android:shadowDy="1.3"
                    android:shadowRadius="1.0"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="设置"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvDrive"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_0"
                android:background="@drawable/shape_user_home"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:nextFocusRight="@+id/tvHistory"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_33"
                android:paddingRight="@dimen/vs_33">


                <ImageView
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:alpha="0.75"
                    android:src="@drawable/hm_folder" />

                <TextView
                    android:id="@+id/tView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="文件"
                    android:textAlignment="gravity"
                    android:textColor="@color/font_deta_color"
                    android:textSize="@dimen/ts_30" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/tvHotList4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvUserHome"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_25"
                    android:paddingBottom="@dimen/vs_5"
                    android:visibility="gone"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_layoutManager="V7GridLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvHotList4"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_25"
                    android:paddingBottom="@dimen/vs_5">

                    <LinearLayout
                        android:id="@+id/tvHistorys"
                        android:layout_width="@dimen/vs_301"
                        android:layout_height="@dimen/vs_130"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_user_j"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/vs_5">

                        <LinearLayout
                            android:layout_width="@dimen/vs_291"
                            android:layout_height="@dimen/vs_120"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_user_f"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/vs_10"
                            android:paddingTop="@dimen/vs_20"
                            android:paddingRight="@dimen/vs_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="观看历史"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_30"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="观看过的影片尽在其中"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_22" />

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvLives"
                        android:layout_width="@dimen/vs_301"
                        android:layout_height="@dimen/vs_130"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_user_j"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/vs_5">

                        <LinearLayout
                            android:layout_width="@dimen/vs_291"
                            android:layout_height="@dimen/vs_120"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_user_g"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/vs_10"
                            android:paddingTop="@dimen/vs_20"
                            android:paddingRight="@dimen/vs_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="直播"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_30"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="央视、卫视一网打尽"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_22" />

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvFavorites"
                        android:layout_width="@dimen/vs_301"
                        android:layout_height="@dimen/vs_130"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_user_j"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/vs_5">

                        <LinearLayout
                            android:layout_width="@dimen/vs_291"
                            android:layout_height="@dimen/vs_120"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_user_h"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/vs_10"
                            android:paddingTop="@dimen/vs_20"
                            android:paddingRight="@dimen/vs_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="收藏"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_30"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="喜欢的影视都在这里"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_22" />

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tvDrives"
                        android:layout_width="@dimen/vs_301"
                        android:layout_height="@dimen/vs_130"
                        android:background="@drawable/shape_user_j"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/vs_5">

                        <LinearLayout
                            android:layout_width="@dimen/vs_291"
                            android:layout_height="@dimen/vs_120"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_user_jj"
                            android:orientation="vertical"
                            android:paddingLeft="@dimen/vs_10"
                            android:paddingTop="@dimen/vs_20"
                            android:paddingRight="@dimen/vs_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="网盘资源"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_30"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="支持本地、webdav、阿里网盘资源"
                                android:textAlignment="gravity"
                                android:textColor="@color/color_80FFFFFF"
                                android:textSize="@dimen/ts_22" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvtxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_5"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:paddingLeft="@dimen/vs_35"
                    android:paddingRight="@dimen/vs_5"
                    android:singleLine="true"
                    android:text="热播推荐"
                    android:textColor="@color/color_03DAC5"
                    android:textSize="@dimen/ts_28"
                    android:textStyle="bold" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/tvHotList1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/vs_30"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_25"
                    android:paddingBottom="@dimen/vs_5"
                    android:visibility="gone"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
            </LinearLayout>
        </ScrollView>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/tvHotList2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tvUserHome"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_8"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_5"
            android:visibility="gone"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_layoutManager="V7GridLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

    </RelativeLayout>

</RelativeLayout>