<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="@dimen/vs_5">

        <CheckBox
            android:id="@+id/oneSearchSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_dialog_main"
            android:button="@drawable/selector_checkbox"
            android:shadowColor="@color/color_FF000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1.0"
            android:drawablePadding="@dimen/vs_10"
            android:focusable="true"
            android:padding="@dimen/vs_10"
            android:text="Check Source"
            android:textColor="@color/font_deta_color"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>
</FrameLayout>