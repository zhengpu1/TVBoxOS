<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/button_detail_quick_searcha"
    android:padding="@dimen/vs_0"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/llgrid"
        android:background="@drawable/shape_user_focus1"
        android:padding="@dimen/vs_4"
        android:layout_width="@dimen/vs_200"
        android:layout_height="260mm">
        <ImageView
            android:id="@+id/ivThumb"
            android:background="@drawable/button_detail_quick_search"
            android:padding="@dimen/vs_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_0"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_marginRight="@dimen/vs_5">
            <TextView
                android:textSize="@dimen/ts_16"
                android:textColor="@color/color_80FFFFFF"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tvSite"
                android:background="@drawable/shape_thumb_year"
                android:paddingLeft="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_5"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/vs_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_1">
            <TextView
                android:textSize="@dimen/ts_18"
                android:textColor="@color/color_FFF68E33"
                android:ellipsize="marquee"
                android:id="@+id/tvNote"
                android:background="@drawable/shape_thumb_bottom_name"
                android:padding="@dimen/vs_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/llgrids"
        android:layout_width="@dimen/vs_200"
        android:layout_height="@dimen/vs_300">
        <TextView
            android:textSize="@dimen/ts_20"
            android:textColor="@color/font_deta_color"
            android:ellipsize="marquee"
            android:layout_gravity="bottom"
            android:id="@+id/tvName"
            android:padding="@dimen/vs_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="@color/color_FF000000"
            android:shadowDx="0.2"
            android:shadowDy="0.2"
            android:shadowRadius="1"
            android:marqueeRepeatLimit="marquee_forever"/>
    </FrameLayout>
</FrameLayout>