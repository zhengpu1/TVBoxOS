<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvQuick"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/button_dialog_main"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_5"
        android:paddingRight="@dimen/vs_35">

        <TextView
            android:id="@+id/tvSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:padding="@dimen/vs_10"
            android:singleLine="true"
            android:duplicateParentState="true"
            android:textColor="@color/font_deta_color"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvTyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:padding="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/font_deta_color"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvName"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:padding="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/font_deta_color"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:padding="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/font_deta_color1"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

</FrameLayout>