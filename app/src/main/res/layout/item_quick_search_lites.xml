<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvQuick"
    android:background="@drawable/button_dialog_main"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_5"
        android:paddingRight="@dimen/vs_5"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/vs_100"
        android:layout_height="@dimen/vs_40">
        <TextView
            android:textSize="@dimen/ts_18"
            android:textColor="@color/font_deta_color"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:id="@+id/tvSite"
            android:paddingLeft="@dimen/vs_5"
            android:paddingTop="@dimen/vs_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="@color/color_FF000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"/>
        <TextView
            android:textSize="@dimen/ts_16"
            android:textColor="@color/font_deta_color"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:id="@+id/tvName"
            android:paddingLeft="@dimen/vs_5"
            android:paddingTop="@dimen/vs_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
</FrameLayout>