<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape>
            <corners android:radius="2mm" />
            <solid android:color="@color/color_6C3D3D3D" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="@color/color_themex_80"
                android:endColor="@color/color_themex_20"
                android:type="radial"
                android:gradientRadius="50" />
            <corners android:radius="5.0mm" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_10" />
            <stroke android:width="1.5mm" android:color="@color/color_theme_h" />
            <gradient
                android:angle="135.0"
                android:centerColor="@color/color_themex_80"
                android:endColor="@color/color_themex_40"
                android:startColor="@color/color_themex_40" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/vs_10" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>