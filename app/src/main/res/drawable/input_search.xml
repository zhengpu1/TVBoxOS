<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_2" />
            <solid android:color="@color/color_theme_20" />
            <stroke android:width="1.5mm" android:color="@color/color_theme_h" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_2" />
            <stroke android:width="1.5mm" android:color="@color/color_22FFFFFF" />
            <solid android:color="#1A050505" />
        </shape>
    </item>
</selector>